{
  "name": "izi-queue",
  "version": "0.7.0",
  "description": "A minimal, reliable, database-backed job queue for Node.js inspired by Oban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "benchmark": "npx tsx benchmarks/benchmark.ts",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build"
  },
  "keywords": [
    "job-queue",
    "background-jobs",
    "task-queue",
    "worker",
    "postgresql",
    "mysql",
    "sqlite",
    "oban",
    "queue",
    "jobs",
    "async",
    "typescript"
  ],
  "author": "Iago Cavalcante",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IagoCavalcante/izi-queue.git"
  },
  "bugs": {
    "url": "https://github.com/IagoCavalcante/izi-queue/issues"
  },
  "homepage": "https://github.com/IagoCavalcante/izi-queue#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0 <14.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.4",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.66.0"
  }
}
